ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Provider de LLM: openrouter | anthropic | gemini | vazio (autodetecta pelo modelo)
LLM_PROVIDER=openrouter
# Com OpenRouter, modelo no formato vendor/modelo (ex: anthropic/claude-3.5-sonnet, openai/gpt-4o)
LLM_MODEL=anthropic/claude-3.5-sonnet

# OpenRouter (uma chave, varios modelos)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://seu-dominio.com

# Bearer token que protege os endpoints /brain/split e /embed (consumidos pelo CRM)
AGENT_API_TOKEN=
# Vertex AI obrigatorio para brain/split e embeddings
GEMINI_USE_VERTEX=true

CRM_BASE_URL=http://localhost:3000
CRM_API_TOKEN=

REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400
DEBOUNCE_SECONDS=5

UZAPI_WEBHOOK_SECRET=

GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON=

APP_ENV=development
LOG_LEVEL=INFO
PORT=8000
